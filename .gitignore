# Build products
build/
.build/
DerivedData/
*.xcuserdatastate
.DS_Store

# Vendored binaries (rebuilt by scripts/bootstrap.sh)
vendor/
!vendor/README.md

# User media and generated fixtures are not committed
samples/*
!samples/manifest.json
!samples/README.md

# Self-QA artifacts. Routine re-runs are noise, so PNGs are ignored by default and
# the evidence a phase is accepted on is pinned explicitly with `git add -f`.
selfqa/out/**/*.png
selfqa/out/**/*.raw
!selfqa/out/phase-1/dv-corruption/*.png
!selfqa/out/phase-2/loopback/*.png
!selfqa/out/phase-2/playback/*.png
!selfqa/out/phase-2/beat-synced-corruption/*.png
!selfqa/out/phase-2/ui-layout/*.png
!selfqa/out/phase-3/composite-codec/*.png
!selfqa/out/phase-3/analog-chain/*.png
!selfqa/out/phase-3/feedback-latency/*.png
!selfqa/out/phase-4/blend-modes/*.png
!selfqa/out/phase-4/generators/*.png
!selfqa/out/phase-5/scopes/*.png

# Local device identity (machine-specific)
config/devices.json

# Photo sequences are USER MEDIA. A folder of photographs dropped in here plays as a
# clip (see ImageSequenceDecoder) and is exactly the kind of thing CLAUDE.md says is
# referenced and never bundled — these are someone's own pictures.
samples/photos/
